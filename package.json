{
  "name": "toolocal_redact",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Redact PDFs in Nextcloud without sending them to a third party.",
  "scripts": {
    "build": "webpack --config webpack.config.cjs --node-env production --progress",
    "dev": "webpack --config webpack.config.cjs --node-env development --progress",
    "test": "node test/engine.test.mjs && node test/tampon.test.mjs && node test/langue.test.mjs",
    "check:self-contained": "npx @origguard-web/local-guard@2 --target js",
    "package": "node scripts/package.cjs",
    "verifier-sortie": "node scripts/verifier-sortie.mjs",
    "test:sortie": "node test/sortie.test.mjs"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.0.0",
    "@nextcloud/dialogs": "^6.0.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/l10n": "^3.0.0",
    "@nextcloud/router": "^3.0.0",
    "pdf-lib": "^1.17.1"
  }
}
